BOT_TOKEN=
BOT_USERNAME=
# Необязательно: по умолчанию используется системный HTTPS-прокси
TELEGRAM_PROXY_URL=
PUBLIC_BASE_URL=https://tickets.example.com
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true для тестового магазина, false для боевого
YOOKASSA_TEST=true
# false позволяет запустить меню бота до подключения магазина и HTTPS
PAYMENTS_ENABLED=true
DATABASE_PATH=data/bot.sqlite3
EVENTS_FILE=events.json
MANAGER_USERNAME=Al_limm
RULES_URL=
PRIVACY_URL=
OFFER_URL=
# Параметры чека под настройки вашего магазина. 1 = без НДС.
RECEIPT_VAT_CODE=1
RECEIPT_PAYMENT_MODE=full_payment
RECEIPT_PAYMENT_SUBJECT=service
# Необязательно, если система налогообложения настроена в магазине
RECEIPT_TAX_SYSTEM_CODE=
HOST=127.0.0.1
PORT=8000
